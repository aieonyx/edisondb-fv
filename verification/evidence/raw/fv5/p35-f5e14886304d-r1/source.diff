+    match checkpoint_bytes {
+        Some(bytes) => {
+            let checkpoint: AuthenticatedAuditCheckpoint =
+                serde_json::from_slice(bytes)
+                    .map_err(|_| EdisonError::AuditChainBroken)?;
+
+            let context =
+                checkpoint_auth_context(store_secret, checkpoint.store_salt)?;
